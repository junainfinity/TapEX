{
  "name": "@maya/game-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@maya/contracts": "workspace:*",
    "@maya/config": "workspace:*",
    "three": "0.186.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "@types/three": "0.186.0"
  }
}
