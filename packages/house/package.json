{
  "name": "@maya/house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./data/*": "./data/*"
  },
  "files": ["dist", "data"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": { "@maya/contracts": "workspace:*", "@maya/config": "workspace:*" },
  "devDependencies": { "typescript": "7.0.2", "vitest": "5.0.1", "@types/node": "24.13.6" }
}
